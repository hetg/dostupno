{
  "name": "dostupno",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that makes any website more accessible for screen reader and low-vision users. Ukrainian-first.",
  "type": "module",
  "scripts": {
    "test": "node test/run-fixers.mjs",
    "audit": "node test/audit-sites.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test:e2e": "node test/e2e-extension.mjs",
    "lint": "eslint . && web-ext lint --source-dir extension",
    "check": "npm run lint && npm test && npm run test:e2e && openspec validate --all --strict"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "2.2.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "playwright": "^1.48.0",
    "web-ext": "10.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
